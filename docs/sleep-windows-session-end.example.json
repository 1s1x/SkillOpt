              "C:/PATH TO/SkillOpt/scripts/sleep_windows_pilot.py", "mark",
              "--marker-dir", "C:/PATH TO/LOCAL SESSION MARKERS"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
